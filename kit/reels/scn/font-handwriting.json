{"id": "font-handwriting", "url": "http://127.0.0.1:8085/", "prep": [], "intro": {"kicker": "Make it yours", "title": "Turn your handwriting into a real font.", "sub": "Write on your phone, get a .ttf file", "url": "font.315tools.com", "say": "Want your own handwriting as a real font? You can make one on your phone."}, "scenes": [{"say": "Open font dot three one five tools dot com, and tap Start writing here.", "sub": "Open <em>font.315tools.com</em><br>and tap Start writing", "actions": [{"do": "scroll", "sel": "#padBtn", "offset": 300, "ms": 1200}, {"do": "point", "sel": "#padBtn", "label": "Start writing here"}, {"do": "press"}, {"do": "frameEval", "js": "(()=>{const s=document.getElementById('padPack');const o=[...s.options].find(o=>/Latin/i.test(o.text));if(o){s.value=o.value;s.dispatchEvent(new Event('change',{bubbles:true}))}})()"}]}, {"say": "Write each letter with your finger, and tap Next.", "sub": "Write each letter<br>with your <em>finger</em>", "actions": [{"do": "scroll", "sel": "#padCanvas", "offset": 150, "ms": 900}, {"do": "draw", "sel": "#padCanvas", "glyphs": ["A", "B", "C"], "next": "#padNext"}]}, {"say": "Then tap Make font, and save your own font file.", "sub": "Tap <em>Make font</em><br>and save your .ttf", "actions": [{"do": "scroll", "sel": "#build", "offset": 330, "ms": 1300}, {"do": "point", "sel": "#build", "label": "Make font"}, {"do": "press", "noclick": true, "ms": 900}]}], "outro": {"title": "Your handwriting, as a real font.", "chips": ["Free", "No sign-up", "Made on your device"], "url": "font.315tools.com", "say": "Free, no sign-up, and made right on your device."}}
